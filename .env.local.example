# ==============================================================================
# OSC SmartCheck AI - Local Environment Configuration Template (.env.local)
# Copy this file to .env.local and populate with your environment credentials.
# DO NOT COMMIT REAL API KEYS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client SDK (Public - Exposed to Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForDevelopmentOnly1234
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=osc-smartcheck-mplbp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=osc-smartcheck-mplbp
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=osc-smartcheck-mplbp.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase Emulator Toggle (Set to 'true' during offline/local emulator development)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ------------------------------------------------------------------------------
# 2. Application Runtime & Environment Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
STAGING_NOTIFICATION_ALLOWLIST=pegawai@mplbp.gov.my,admin@mplbp.gov.my

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Server-Side Only - Private)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=osc-smartcheck-mplbp
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@osc-smartcheck-mplbp.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=osc-smartcheck-mplbp.appspot.com
# Optional: Path to Google Application Credentials JSON file (alternative to private key)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-file.json
# Optional: Firebase Emulator Hub Host:Port when running emulators
# FIREBASE_EMULATOR_HUB=127.0.0.1:4400

# ------------------------------------------------------------------------------
# 4. Authoritative Geospatial Database (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://osc_user:osc_password_secret@127.0.0.1:5432/osc_smartcheck_gis?sslmode=disable
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=osc_smartcheck_gis
POSTGRES_USER=osc_user
POSTGRES_PASSWORD=osc_password_secret

# ------------------------------------------------------------------------------
# 5. Google Cloud Document AI (LCP Document Processing Engine)
# ------------------------------------------------------------------------------
DOCUMENT_AI_PROJECT_ID=osc-smartcheck-mplbp
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=123456789abcdef0

# ------------------------------------------------------------------------------
# 6. Google Gemini / Genkit / Vertex AI (AI Technical Comment Assistant)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyPlaceholderGeminiApiKeyForDevelopmentOnly
GOOGLE_CLOUD_PROJECT=osc-smartcheck-mplbp

# ------------------------------------------------------------------------------
# 7. Observability & Performance Monitoring (Sentry / Cloud Logging)
# ------------------------------------------------------------------------------
SENTRY_DSN=https://placeholderkey@o123456.ingest.sentry.io/7654321
NEXT_PUBLIC_SENTRY_DSN=https://placeholderkey@o123456.ingest.sentry.io/7654321
